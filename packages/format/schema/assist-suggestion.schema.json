            "type": "object",
            "properties": {
              "rule": {
                "type": "string"
              },
              "sources": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                }
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "description": "Passage of the record, copied word for word"
              }
            },
            "required": [
              "rule",
              "sources",
              "quote"
            ],
            "additionalProperties": false
          }
        },
        "replaced": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": {
                "type": "string"
              },
              "record": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "replacedBy": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              }
            },
            "required": [
              "rule",
              "record",
              "replacedBy"
            ],
            "additionalProperties": false
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "point": {
                "type": "string"
              },
              "records": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9999
                }
              }
            },
            "required": [
              "point",
              "records"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "status",
        "provenance",
        "rules",
        "replaced",
        "conflicts"
      ],
      "additionalProperties": false
    },
