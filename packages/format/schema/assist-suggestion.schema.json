{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "check"
        },
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "status": {
          "type": "string",
          "const": "suggested"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "promptVersion": {
              "type": "string"
            },
            "inputHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "SHA-256 of the request, as Compadr serialized it"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            }
          },
          "required": [
            "model",
            "promptVersion",
            "inputHash",
            "createdAt"
          ],
          "additionalProperties": false
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "decision": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9999
              },
              "verdict": {
                "type": "string",
                "enum": [
                  "violated",
                  "at-risk"
                ]
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "description": "Passage of the decision text that states the rule, copied word for word"
              },
              "evidence": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text": {
                    "type": "string",
                    "description": "Line or lines of the diff"
                  }
                },
                "required": [
                  "path",
                  "text"
                ],
                "additionalProperties": false
              },
              "explanation": {
                "type": "string"
              }
            },
            "required": [
              "decision",
              "verdict",
              "quote",
              "evidence",
              "explanation"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "status",
        "provenance",
        "findings"
      ],
      "additionalProperties": false
    },
    {
